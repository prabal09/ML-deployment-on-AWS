[Unit]
Description=Gunicorn WSGI server for Iris ML API
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ML-deployment-on-AWS/projects/project-2-dev
ExecStart=/home/ubuntu/ML-deployment-on-AWS/projects/project-2-dev/venv/bin/gunicorn app:app -c gunicorn.conf.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
